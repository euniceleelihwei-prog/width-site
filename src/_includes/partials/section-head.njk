{%- if s.eyebrow or s.title or s.lead %}
<div class="section-head{% if s.center %} center{% endif %}">
  {%- if s.eyebrow %}<p class="eyebrow">{{ s.eyebrow }}</p>{% endif %}
  {%- if s.title %}<h2>{{ s.title | safe }}</h2>{% endif %}
  {%- if s.lead %}<div class="lead">{{ s.lead | md | safe }}</div>{% endif %}
</div>
{%- endif %}
