{#- 四档处置 -#}
{%- set zh = (lang == 'zh') -%}
<figure class="viz viz-scores">
  <ol class="score-bands">
    <li class="pass"><b>0–19</b><span>{{ '通过' if zh else 'Pass' }}</span><p>{{ '自动放行' if zh else 'Let it through automatically' }}</p></li>
    <li class="review"><b>20–49</b><span>{{ '复核' if zh else 'Review' }}</span><p>{{ '人工看一眼' if zh else 'A quick human look' }}</p></li>
    <li class="edd"><b>50–79</b><span>{{ '加强尽调' if zh else 'EDD' }}</span><p>{{ '请用户说明资金来源' if zh else 'Ask for source of funds' }}</p></li>
    <li class="block"><b>80–100</b><span>{{ '拦截' if zh else 'Block' }}</span><p>{{ '建议拒绝' if zh else 'Refuse the transfer' }}</p></li>
  </ol>
</figure>
