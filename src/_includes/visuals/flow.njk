{#- 首页主视觉：按时间顺序追资金。一条顺序成立的风险路径计分；一条时间倒流的路径被排除；交易所对手方豁免。地址均为示意。 -#}
{%- set zh = (lang == 'zh') -%}
<figure class="viz viz-flow">
  <svg viewBox="0 0 560 440" role="img" aria-labelledby="flow-t flow-d">
    <title id="flow-t">{{ '按时间顺序追踪资金' if zh else 'Tracing funds in time order' }}</title>
    <desc id="flow-d">{{ '被筛地址的上游有三条资金路径：一条时间顺序成立、计入评分；一条时间倒流、被排除；一条来自交易所、默认豁免。' if zh else 'Three upstream paths: one in valid time order is scored, one runs backwards in time and is excluded, one comes from an exchange and is exempt.' }}</desc>
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--viz-risk)"/></marker>
      <marker id="arr-mute" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--viz-mute)"/></marker>
      <marker id="arr-ex" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--viz-ex)"/></marker>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="var(--accent)" stop-opacity=".35"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></radialGradient>
    </defs>

    <!-- 跳数环 -->
    <g class="rings" fill="none">
      <circle cx="430" cy="220" r="90"/><circle cx="430" cy="220" r="170"/><circle cx="430" cy="220" r="250"/>
    </g>
    <text class="ring-label" x="430" y="122" text-anchor="middle">HOP 1</text>
    <text class="ring-label" x="430" y="42" text-anchor="middle">HOP 2</text>

    <!-- 路径 A：制裁实体 → 中间地址 → 被筛地址，时间顺序成立 -->
    <path class="edge risk" d="M92 92 C170 92 210 120 268 140" marker-end="url(#arr)"/>
    <path class="edge risk" d="M318 150 C360 165 380 190 398 204" marker-end="url(#arr)"/>
    <text class="t-time ok" x="160" y="84">10-28 09:12</text>
    <text class="t-time ok" x="338" y="150">10-29 14:03</text>

    <!-- 路径 B：黑客 → 中间地址 → 被筛地址，但先转出后到账：时间倒流 -->
    <path class="edge mute" d="M92 228 C170 228 210 236 262 238" marker-end="url(#arr-mute)"/>
    <path class="edge mute" d="M314 238 C350 236 370 230 394 224" marker-end="url(#arr-mute)"/>
    <text class="t-time bad" x="160" y="220">11-03 21:40</text>
    <text class="t-time" x="318" y="266">11-02 08:15</text>
    <line class="strike" x1="196" y1="246" x2="226" y2="216"/>

    <!-- 路径 C：交易所 → 被筛地址 -->
    <path class="edge ex" d="M92 360 C220 360 320 300 400 238" marker-end="url(#arr-ex)"/>

    <!-- 源头节点 -->
    <g class="node risk"><rect x="12" y="74" width="80" height="36" rx="18"/><text x="52" y="97" text-anchor="middle">{{ '制裁实体' if zh else 'Sanctioned' }}</text></g>
    <g class="node risk"><rect x="12" y="210" width="80" height="36" rx="18"/><text x="52" y="233" text-anchor="middle">{{ '黑客' if zh else 'Hacker' }}</text></g>
    <g class="node ex"><rect x="12" y="342" width="80" height="36" rx="18"/><text x="52" y="365" text-anchor="middle">{{ '交易所' if zh else 'Exchange' }}</text></g>

    <!-- 中间地址 -->
    <g class="node hop"><circle cx="292" cy="146" r="22"/><text x="292" y="150" text-anchor="middle">0x8a…</text></g>
    <g class="node hop dim"><circle cx="288" cy="238" r="22"/><text x="288" y="242" text-anchor="middle">TQf…</text></g>

    <!-- 被筛地址 -->
    <circle cx="430" cy="220" r="60" fill="url(#glow)"/>
    <g class="node target"><circle cx="430" cy="220" r="30"/><text x="430" y="217" text-anchor="middle">TZC…</text><text class="sub" x="430" y="232" text-anchor="middle">{{ '被筛地址' if zh else 'screened' }}</text></g>

    <!-- 路径说明 -->
    <g class="callout ok"><rect x="122" y="104" width="134" height="24" rx="6"/><text x="189" y="120" text-anchor="middle">{{ '先到账后转出 · 占比 18%' if zh else 'in time order · 18% share' }}</text></g>
    <g class="callout bad"><rect x="112" y="258" width="150" height="24" rx="6"/><text x="187" y="274" text-anchor="middle">{{ '时间倒流 · 排除' if zh else 'runs backwards · excluded' }}</text></g>
    <g class="callout ex"><rect x="150" y="318" width="132" height="24" rx="6"/><text x="216" y="334" text-anchor="middle">{{ '交易所对手方 · 豁免' if zh else 'exchange · exempt' }}</text></g>
    <!-- 沿着计分路径和豁免路径移动的点（动画）；时间倒流的那条路径没有点 -->
    <circle class="flow-dot risk" r="4.500"><animateMotion dur="2.6s" begin="0.0s" repeatCount="indefinite" path="M92 92 C170 92 210 120 268 140"/></circle>
    <circle class="flow-dot risk" r="4.500"><animateMotion dur="2.6s" begin="1.3s" repeatCount="indefinite" path="M318 150 C360 165 380 190 398 204"/></circle>
    <circle class="flow-dot ex" r="4.500"><animateMotion dur="3.4s" begin="2.6s" repeatCount="indefinite" path="M92 360 C220 360 320 300 400 238"/></circle>
  </svg>

  <figcaption class="viz-result">
    <div class="score-dial"><span class="dial-n"></span><small>/100</small></div>
    <div>
      <p class="mini-label">{{ '资金占比评分' if zh else 'Fund-attribution score' }}</p>
      <p class="verdict review">{{ '复核 · REVIEW' if zh else 'REVIEW' }}</p>
      <p class="viz-note">{{ '只有那条时间顺序成立的路径计入，原因逐条列出。' if zh else 'Only the path that holds up in time is scored, and every point is explained.' }}</p>
    </div>
  </figcaption>
</figure>
