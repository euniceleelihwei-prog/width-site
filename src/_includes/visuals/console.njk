{#- console：一张大的产品示意图。左边是结果卡（result），右边是资金图（flow）。地址为示意。 -#}
{%- set zh = (lang == 'zh') -%}
<div class="console">
  <div class="console-bar"><b>{{ '地址筛查 · KYA' if zh else 'Address Screening · KYA' }}</b><span>Tron · USDT</span><i>{{ '资金图' if zh else 'Fund Graph' }}</i><i>{{ '命中明细' if zh else 'Hits' }}</i><i>{{ '快照' if zh else 'Snapshot' }}</i></div>
  <div class="console-body">
    <div class="console-side">{% include "visuals/result.njk" %}</div>
    <div class="console-main">{% include "visuals/flow.njk" %}</div>
  </div>
</div>
