{#- cases：匿名案例。items[{tag, title, text, metric, metricLabel}] -#}
<section class="section {{ s.tone }}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    {% include "partials/section-head.njk" %}
    <div class="cases cols-{{ s.columns or 3 }}">
      {%- for c in s.items %}
      <article class="case">
        {%- if c.tag %}<span class="chip">{{ c.tag }}</span>{% endif %}
        {%- if c.metric %}<p class="case-metric">{{ c.metric }}{% if c.metricLabel %}<small>{{ c.metricLabel }}</small>{% endif %}</p>{% endif %}
        <h3>{{ c.title }}</h3>
        <p>{{ c.text | mdi | safe }}</p>
      </article>
      {%- endfor %}
    </div>
    {%- if s.note %}<p class="section-note">{{ s.note | mdi | safe }}</p>{% endif %}
  </div>
</section>
