{#- audiences：按客户类型切换的标签页。items[{label, title, text, points[], href, link}] -#}
<section class="section {{ s.tone }}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    {% include "partials/section-head.njk" %}
    <div class="tabs" data-tabs>
      <div class="tab-list" role="tablist">
        {%- for a in s.items %}
        <button role="tab" id="tab-{{ s.id or 'aud' }}-{{ loop.index }}" aria-controls="panel-{{ s.id or 'aud' }}-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ a.label }}</button>
        {%- endfor %}
      </div>
      {%- for a in s.items %}
      <div class="tab-panel" role="tabpanel" id="panel-{{ s.id or 'aud' }}-{{ loop.index }}" aria-labelledby="tab-{{ s.id or 'aud' }}-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
        <div class="tab-copy">
          <h3>{{ a.title }}</h3>
          <p>{{ a.text | mdi | safe }}</p>
          {%- if a.href %}<a class="link-arrow" href="{{ a.href | locale(lang) }}">{{ a.link or i18n[lang].learnMore }}</a>{% endif %}
        </div>
        <ul class="tab-points">
          {%- for p in a.points %}
          <li><span class="tick" aria-hidden="true"></span><div>{{ p | mdi | safe }}</div></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
