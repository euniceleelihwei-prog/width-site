{#- cta：底部行动号召。title, text, points[], ctas -#}
<section class="section cta-section"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    <div class="cta-band">
      <div class="cta-copy">
        {%- if s.eyebrow %}<p class="eyebrow">{{ s.eyebrow }}</p>{% endif %}
        <h2>{{ s.title | safe }}</h2>
        {%- if s.text %}<div class="lead">{{ s.text | md | safe }}</div>{% endif %}
      </div>
      <div class="cta-side">
        {%- if s.points %}<ol class="cta-points">{% for p in s.points %}<li>{{ p | mdi | safe }}</li>{% endfor %}</ol>{% endif %}
        {%- set ctas = s.ctas %}{% include "partials/ctas.njk" %}
      </div>
    </div>
  </div>
</section>
