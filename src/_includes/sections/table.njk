{#- table：head[], rows[[...]], note -#}
<section class="section {{ s.tone }}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    {% include "partials/section-head.njk" %}
    <div class="table-wrap">
      <table>
        <thead><tr>{% for h in s.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
          {%- for r in s.rows %}
          <tr>{% for cell in r %}{% if loop.first %}<th scope="row">{{ cell | mdi | safe }}</th>{% else %}<td>{{ cell | mdi | safe }}</td>{% endif %}{% endfor %}</tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    {%- if s.note %}<p class="section-note">{{ s.note | mdi | safe }}</p>{% endif %}
  </div>
</section>
